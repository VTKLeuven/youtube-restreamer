# Copy to .env and adjust. Used by `docker compose up -d`.

# Stream to start with. Leave empty to pick one on the control page.
URL=
# best, 1080p, 720p, 480p, ... (comma list = fallbacks, e.g. 720p,480p,best)
QUALITY=720p
# Port on the server for VLC viewers and the control page.
PORT=8080
# 1 = only download while at least one VLC is connected (+ IDLE_TIMEOUT seconds).
# 0 = always download as soon as a URL is set.
ON_DEMAND=1
IDLE_TIMEOUT=30
# Server address printed in the logs, e.g. 192.168.1.10 (optional; the
# control page always shows the right VLC address anyway).
ADVERTISE=
# Timezone for the log timestamps.
TZ=Europe/Brussels
